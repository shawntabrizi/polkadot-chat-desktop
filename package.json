{
  "name": "polkadot-chat-desktop",
  "productName": "Polkadot Chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "check": "tsc --noEmit -p tsconfig.json && vitest run && eslint .",
    "test": "vitest run",
    "lint": "eslint .",
    "smoke": "npm run build && electron out/main/index.js --smoke",
    "package": "npm run build && electron-builder --mac --arm64",
    "smoke:packaged": "bash scripts/smoke-packaged.sh",
    "postinstall": "node -e \"const fs = require('fs'); const d = 'node_modules/electron/dist'; process.exit(fs.existsSync(d) && fs.readdirSync(d).length > 0 ? 0 : 1)\" || node node_modules/electron/install.js",
    "prepare": "papi generate",
    "identity:register": "node scripts/identity-register.mjs",
    "e2e:chat": "node scripts/e2e-chat.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@novasamatech/host-chat": "0.10.2",
    "@novasamatech/host-papp": "0.10.2",
    "@novasamatech/scale": "0.10.2",
    "@novasamatech/statement-store": "0.10.2",
    "@polkadot-api/descriptors": "file:.papi/descriptors",
    "@polkadot-api/substrate-bindings": "0.21.1",
    "@polkadot-labs/hdkd-helpers": "0.0.30",
    "@scure/bip39": "2.4.0",
    "@scure/sr25519": "2.2.0",
    "dexie": "4.4.5",
    "dompurify": "3.4.14",
    "markdown-it": "15.0.1",
    "neverthrow": "8.2.0",
    "polkadot-api": "3.1.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rxjs": "7.8.2",
    "scale-ts": "1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
